-- ┌─────────────────────────────────────────────────────────────┐
-- │ Hyprland config — surgical setup (pairs with Gentleman.Dots)  │
-- │ Docs: https://wiki.hypr.land/Configuring/                     │
-- └─────────────────────────────────────────────────────────────┘
--
-- COMMON CORE. Everything here must be true on EVERY machine that shares this
-- repo. Anything hardware-, output- or role-specific belongs in the per-host
-- file required at the very bottom — this file has exactly ONE templated line,
-- so a mistake has a blast radius of one statement instead of 300.
--
-- Migrated from hyprland.conf: the .conf format is removed in Hyprland 0.57.
-- The old .conf is kept alongside as a fallback: delete this file and Hyprland
-- falls straight back to it.

---------------------
---- MONITORS    ----
---------------------
-- output, mode, position, scale. preferred/auto autodetects.
-- KEEP THIS FIRST and keep it here: it is the only thing that gives an
-- unrecognised machine (or a host file that failed to load) a usable output.
-- Per-host monitor lines are required at the bottom and override this.
hl.monitor({
    output   = "",
    mode     = "preferred",
    position = "auto",
    scale    = 1,
})

---------------------
---- PROGRAMS    ----
---------------------
local terminal    = "env GTK_IM_MODULE=simple ghostty"
local fileManager = "nemo"
local menu        = "wofi --show drun"
local mainMod     = "SUPER"

---------------------
---- AUTOSTART   ----
---------------------
hl.on("hyprland.start", function()
    -- Propagate Wayland env to systemd/dbus so portals + the polkit agent work.
    -- Pinned to /usr/bin on purpose: a bare name resolves to the Homebrew copy, which
    -- would leave this line — and therefore portals and the polkit agent — broken on a
    -- machine without Homebrew on PATH. That is a far worse failure than a dead keybind.
    hl.exec_cmd("/usr/bin/dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP")

    -- Authentication agent (graphical password prompts)
    hl.exec_cmd("systemctl --user start hyprpolkitagent")

    -- Bar, wallpaper, notifications, idle daemon
    hl.exec_cmd("waybar")
    hl.exec_cmd(os.getenv("HOME") .. "/.config/hypr/scripts/wallpaper.sh")
    hl.exec_cmd("mako")
    -- nm-applet disabled: Waybar `network` module is now the clickable network menu (network-menu.sh)
    -- KeePassXC: vault + system Secret Service (org.freedesktop.secrets) + ssh-agent.
    hl.exec_cmd("keepassxc")

    -- Clipboard history (text + images)
    hl.exec_cmd("wl-paste --type text --watch cliphist store")
    hl.exec_cmd("wl-paste --type image --watch cliphist store")
end)

-- NOTE: session lock (hyprlock), hypridle, kwalletd6, the always-on Claude
-- session and any remote-desktop server live in the per-host file — they differ
-- in form or must not exist at all on some hosts.

-------------------------------
---- ENVIRONMENT VARIABLES ----
-------------------------------
-- A real cursor theme MUST be set. With the unset "default" theme, Hyprland's
-- built-in fallback cursor can't be captured by wayvnc and shows as a black box
-- over VNC — and even with no VNC in play, an unset theme can fall back to a
-- broken/box glyph. Adwaita is a complete xcursor theme.
hl.env("XCURSOR_THEME", "Adwaita")
hl.env("XCURSOR_SIZE", "24")
hl.env("HYPRCURSOR_SIZE", "24")

-- GTK 4.20+ dejó de componer dead keys/compose por sí solo en Wayland sin un IME.
-- Esto rompe las tildes (´ + vocal) en apps GTK4 como Ghostty. "simple" restaura
-- la composición estilo X11 sin instalar ibus/fcitx. Aplica a terminales nuevas.
hl.env("GTK_IM_MODULE", "simple")

-- NOTE: AQ_NO_MODIFIERS is deliberately NOT here. It is an AMD Polaris +
-- aquamarine workaround; on Intel i915 it forces linear buffers and loses
-- compression/tiling. It lives in the host file that needs it.

