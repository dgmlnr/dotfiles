#
# ~/.bashrc
#

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

alias ls='ls --color=auto'
alias grep='grep --color=auto'
PS1='[\u@\h \W]\$ '
export PATH="$HOME/.local/bin:$PATH"

# Machine-local secrets, kept out of version control. The file is optional, so a
# fresh machine works before it exists.
[ -f ~/.config/shell/secrets.sh ] && . ~/.config/shell/secrets.sh

# Engram cloud mode is retired: memories sync through the engram-sync git repo,
# not a central server. The old ENGRAM_CLOUD_SERVER pointed at <host>,
# which only resolves on the office LAN, so every autosync from anywhere else
# hung. Restore these only if the cloud server comes back.

eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
