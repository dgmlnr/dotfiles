# ┌─────────────────────────────────────────────────────────────┐
# │ Hyprland config — surgical setup (pairs with Gentleman.Dots)  │
# │ Docs: https://wiki.hyprland.org/Configuring/                  │
# └─────────────────────────────────────────────────────────────┘
#
# COMMON CORE. Everything here must be true on EVERY machine that shares this
# repo. Anything hardware-, output- or role-specific belongs in the per-host
# file sourced at the very bottom — this file has exactly ONE templated line,
# so a mistake has a blast radius of one statement instead of 300.

###################
### MONITORS    ###
###################
# name, resolution, position, scale. "preferred,auto,1" autodetects.
# KEEP THIS FIRST and keep it here: it is the only thing that gives an
# unrecognised machine (or a host file that failed to load) a usable output.
# Per-host monitor lines are sourced at the bottom and override this.
monitor = , preferred, auto, 1

###################
### PROGRAMS    ###
###################
$terminal = env GTK_IM_MODULE=simple ghostty
$fileManager = nemo
$menu = wofi --show drun

#################
### AUTOSTART ###
#################
# Propagate Wayland env to systemd/dbus so portals + the polkit agent work.
# Pinned to /usr/bin on purpose: a bare name resolves to the Homebrew copy, which
# would leave this line — and therefore portals and the polkit agent — broken on a
# machine without Homebrew on PATH. That is a far worse failure than a dead keybind.
exec-once = /usr/bin/dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP

# Authentication agent (graphical password prompts)
exec-once = systemctl --user start hyprpolkitagent

# Bar, wallpaper, notifications, network tray, idle daemon
exec-once = waybar
exec-once = $HOME/.config/hypr/scripts/wallpaper.sh
exec-once = mako
# nm-applet disabled: Waybar `network` module is now the clickable network menu (network-menu.sh)
# exec-once = nm-applet --indicator
# KeePassXC: vault + system Secret Service (org.freedesktop.secrets) + ssh-agent.
exec-once = keepassxc

# Clipboard history (text + images)
exec-once = wl-paste --type text --watch cliphist store
exec-once = wl-paste --type image --watch cliphist store

# NOTE: session lock (hyprlock), hypridle, kwalletd6, the always-on Claude
# session and any remote-desktop server live in the per-host file — they differ
# in form or must not exist at all on some hosts.

#############################
### ENVIRONMENT VARIABLES ###
#############################
# A real cursor theme MUST be set. With the unset "default" theme, Hyprland's
# built-in fallback cursor can't be captured by wayvnc and shows as a black box
# over VNC — and even with no VNC in play, an unset theme can fall back to a
# broken/box glyph. Adwaita is a complete xcursor theme.
env = XCURSOR_THEME,Adwaita
env = XCURSOR_SIZE,24
env = HYPRCURSOR_SIZE,24

# GTK 4.20+ dejó de componer dead keys/compose por sí solo en Wayland sin un IME.
# Esto rompe las tildes (´ + vocal) en apps GTK4 como Ghostty. "simple" restaura
# la composición estilo X11 sin instalar ibus/fcitx. Aplica a terminales nuevas.
env = GTK_IM_MODULE,simple

# NOTE: AQ_NO_MODIFIERS is deliberately NOT here. It is an AMD Polaris +
# aquamarine workaround; on Intel i915 it forces linear buffers and loses
# compression/tiling. It lives in the host file that needs it.

#####################
### LOOK AND FEEL ###
#####################
general {
    gaps_in = 4
    gaps_out = 8
    border_size = 2
    # Dracula: violet -> pink gradient on the focused window
    col.active_border = rgba(bd93f9ee) rgba(ff79c6ee) 45deg
    col.inactive_border = rgba(44475aaa)
    resize_on_border = true
    layout = dwindle
}

decoration {
    rounding = 8
    active_opacity = 1.0
    inactive_opacity = 0.90
    blur {
        enabled = true
        size = 3
        passes = 1
    }
    shadow {
        enabled = true
        range = 4
        render_power = 3
    }
}

animations {
    enabled = true
    bezier = easeOutQuint, 0.23, 1, 0.32, 1
    animation = windows, 1, 4, easeOutQuint
    animation = fade, 1, 4, default
    animation = workspaces, 1, 4, easeOutQuint
}

dwindle {
    preserve_split = true
}

misc {
    force_default_wallpaper = 0
    disable_hyprland_logo = true
}

#############
### INPUT ###
#############
input {
    kb_layout = latam
    numlock_by_default = true
    follow_mouse = 1
    sensitivity = 0
    touchpad {
        natural_scroll = true
    }
}

cursor {
    # Keep hardware cursors (false = use them, the sane default). On the AMD
    # Polaris box this is load-bearing: software cursors leave a black-box
    # artifact over VNC, and the remote pointer is drawn by the VNC client
    # instead. Hardware cursors keep the pointer out of the captured framebuffer.
    no_hardware_cursors = false
}

###################
### KEYBINDINGS ###
###################
$mainMod = SUPER

# Core
bindd = $mainMod, Q, Abrir terminal, exec, $terminal
bindd = $mainMod, W, Abrir Herdr (multiplexor de agentes), exec, $terminal -e herdr
bindd = $mainMod, C, Cerrar ventana activa, killactive,
# SUPER+M (Hyprland's stock `exit` bind) removed on purpose: it tore the session
# down instantly, with no confirmation, one key away from SUPER+N. Logging out
# belongs in the power menu, where it is a deliberate choice. The key stays free
# in the core; hexdev-home reuses it for the panel blank (see its host file).
bindd = $mainMod, E, Abrir gestor de archivos, exec, $fileManager
bindd = $mainMod, V, Alternar ventana flotante o en mosaico, togglefloating,
bindd = $mainMod, R, Abrir lanzador de aplicaciones, exec, $menu
bindd = $mainMod, F, Pantalla completa, fullscreen,
bindd = $mainMod, Escape, Bloquear pantalla, exec, $HOME/.config/hypr/scripts/lock.sh

# Keybind cheatsheet overlay (searchable list of all binds)
# Movido a G (K ahora = foco-arriba en hjkl). Letra, no necesita Shift en latam.
bindd = $mainMod, G, Ver esta chuleta de atajos, exec, $HOME/.config/hypr/scripts/keybinds.sh

# "Minimize" via scratchpad (special workspace): keeps the app running but hidden.
# SUPER+SHIFT+S hides the focused window; SUPER+S toggles the hidden stash on/off.
bindd = $mainMod SHIFT, S, Minimizar ventana (esconder en scratchpad), movetoworkspacesilent, special:magic
bindd = $mainMod, S, Mostrar u ocultar ventanas minimizadas, togglespecialworkspace, magic

# Move focus with mainMod + hjkl (vim) — consistente con Ghostty (ALT+hjkl) y nvim
bindd = $mainMod, H, Foco a la ventana de la izquierda, movefocus, l
bindd = $mainMod, J, Foco a la ventana de abajo, movefocus, d
bindd = $mainMod, K, Foco a la ventana de arriba, movefocus, u
bindd = $mainMod, L, Foco a la ventana de la derecha, movefocus, r

# Move the active window with mainMod + SHIFT + hjkl
bindd = $mainMod SHIFT, H, Mover ventana a la izquierda, movewindow, l
bindd = $mainMod SHIFT, J, Mover ventana hacia abajo, movewindow, d
bindd = $mainMod SHIFT, K, Mover ventana hacia arriba, movewindow, u
bindd = $mainMod SHIFT, L, Mover ventana a la derecha, movewindow, r

# Switch workspaces (mainMod + 1..0)
bindd = $mainMod, 1, Ir al escritorio 1, workspace, 1
bindd = $mainMod, 2, Ir al escritorio 2, workspace, 2
bindd = $mainMod, 3, Ir al escritorio 3, workspace, 3
bindd = $mainMod, 4, Ir al escritorio 4, workspace, 4
bindd = $mainMod, 5, Ir al escritorio 5, workspace, 5
bindd = $mainMod, 6, Ir al escritorio 6, workspace, 6
bindd = $mainMod, 7, Ir al escritorio 7, workspace, 7
bindd = $mainMod, 8, Ir al escritorio 8, workspace, 8
bindd = $mainMod, 9, Ir al escritorio 9, workspace, 9
bindd = $mainMod, 0, Ir al escritorio 10, workspace, 10

# Move active window to workspace (mainMod + SHIFT + 1..0)
bindd = $mainMod SHIFT, 1, Mover ventana al escritorio 1, movetoworkspace, 1
bindd = $mainMod SHIFT, 2, Mover ventana al escritorio 2, movetoworkspace, 2
bindd = $mainMod SHIFT, 3, Mover ventana al escritorio 3, movetoworkspace, 3
bindd = $mainMod SHIFT, 4, Mover ventana al escritorio 4, movetoworkspace, 4
bindd = $mainMod SHIFT, 5, Mover ventana al escritorio 5, movetoworkspace, 5
bindd = $mainMod SHIFT, 6, Mover ventana al escritorio 6, movetoworkspace, 6
bindd = $mainMod SHIFT, 7, Mover ventana al escritorio 7, movetoworkspace, 7
bindd = $mainMod SHIFT, 8, Mover ventana al escritorio 8, movetoworkspace, 8
bindd = $mainMod SHIFT, 9, Mover ventana al escritorio 9, movetoworkspace, 9
bindd = $mainMod SHIFT, 0, Mover ventana al escritorio 10, movetoworkspace, 10

# Scroll through workspaces with mainMod + scroll.
# m+1/m-1 (monitor-relative) instead of e+1/e-1 (global): keeps cycling WITHIN the
# current monitor and won't overshoot onto another monitor's/new empty workspace.
# On the remote-server host this is also a safety property: scrolling can never
# jump focus to the physical panel, which during a Moonlight session is dpms-off
# and would kill the stream.
bindd = $mainMod, mouse_down, Ir al escritorio siguiente (rueda del mouse), workspace, m+1
bindd = $mainMod, mouse_up, Ir al escritorio anterior (rueda del mouse), workspace, m-1

# Move/resize windows with mainMod + LMB/RMB drag
binddm = $mainMod, mouse:272, Arrastrar ventana flotante, movewindow
binddm = $mainMod, mouse:273, Redimensionar ventana flotante, resizewindow

# Clipboard history picker
bindd = $mainMod, Y, Historial del portapapeles, exec, cliphist list | wofi --dmenu | cliphist decode | wl-copy

# Screenshots (grim + slurp). Print = region, SHIFT+Print = full screen
bindd = , Print, Captura de una región, exec, grim -g "$(slurp)" - | wl-copy
bindd = SHIFT, Print, Captura de pantalla completa, exec, grim - | wl-copy

# Tune window transparency live (SUPER+SHIFT+scroll). Bake the value you like
# into the decoration{} block to make it permanent.
bindd = $mainMod SHIFT, mouse_up, Subir opacidad de la ventana, exec, $HOME/.config/hypr/scripts/opacity.sh 0.05
bindd = $mainMod SHIFT, mouse_down, Bajar opacidad de la ventana, exec, $HOME/.config/hypr/scripts/opacity.sh -0.05

# Volume (repeats while held)
binddel = , XF86AudioRaiseVolume, Subir volumen, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
binddel = , XF86AudioLowerVolume, Bajar volumen, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
binddl = , XF86AudioMute, Silenciar o activar el audio, exec, wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

# Brightness (repeats while held)
binddel = , XF86MonBrightnessUp, Subir brillo de pantalla, exec, brightnessctl set 5%+
binddel = , XF86MonBrightnessDown, Bajar brillo de pantalla, exec, brightnessctl set 5%-

# ── Passthrough para escritorio remoto / sesiones remotas / VMs ─────────────
# En Wayland, el compositor LOCAL captura los binds globales antes que la app,
# asi que los combos SUPER+* se los come esta maquina en vez de viajar al host
# remoto. Este submap silencia TODOS los binds locales y manda el teclado entero
# a la ventana enfocada (Moonlight/VNC -> host remoto). SUPER+SHIFT+Escape entra
# y sale. El combo de salida de Moonlight (Ctrl+Alt+Shift+Q) sigue funcionando
# adentro.
#
# Shared on purpose: this is the CLIENT half of the remote-desktop pair, so it
# matters most on the laptop, but it is harmless (and occasionally useful) on
# the server. Bound to SUPER+SHIFT+Escape rather than SUPER+P so that SUPER+P
# stays free for the per-host display selector.
bindd = $mainMod SHIFT, Escape, Passthrough remoto (Moonlight): activar / salir, submap, passthrough
bind = $mainMod SHIFT, Escape, exec, notify-send "Passthrough ON" "Atajos locales OFF — van a la PC remota"
submap = passthrough
bind = $mainMod SHIFT, Escape, submap, reset
bind = $mainMod SHIFT, Escape, exec, notify-send "Passthrough OFF" "Atajos locales restaurados"
submap = reset

##############################
### WINDOW RULES            ###
##############################
# Float common dialog/utility windows instead of tiling them.
# Hyprland 0.53+ windowrule grammar: "match:<cond> <regex>, <effect> <value>"
# (matchers first, comma, then the effect with its value). Old "float,class:" is gone.
windowrule = match:class org.pulseaudio.pavucontrol, float on
windowrule = match:class org.pulseaudio.pavucontrol, size 720 520
windowrule = match:class org.pulseaudio.pavucontrol, center on

# RDM abre sus diálogos (configuración, etc.) flotando pegados arriba, con la
# barra de título tapada por waybar. Centrar las ventanas flotantes para que
# siempre se puedan agarrar. (center solo afecta a flotantes; la ventana
# principal de RDM tilea, así que no se toca.)
windowrule = match:class RemoteDesktopManager, center on
windowrule = match:class nm-connection-editor, float on
windowrule = match:class blueman-manager, float on
windowrule = match:class org.gnome.Calculator, float on

# gsimplecal: clock popup, float and drop centered just below the bar (under the cursor click).
# NOTE: 775 46 is a pixel offset derived from a 1920-wide primary output with a
# 44px bar. It lands off-centre on a primary of any other width; move this line
# into the host files if a host's primary stops being 1920 wide.
windowrule = match:class gsimplecal, float on
windowrule = match:class gsimplecal, move 775 46

# Auto-started remote-control Claude session lives in its OWN hidden special
# workspace (separate from the SUPER+S scratchpad, so it never shows up there).
# To peek at it locally: hyprctl dispatch togglespecialworkspace claude
# The rule is shared; the autostart that produces the window is per-host,
# because the two hosts launch that session by different mechanisms.
windowrule = match:class com.claude.remote, workspace special:claude silent

# Thunderbird lives on workspace 10. silent = opens there without pulling focus.
# Shared: the rule is harmless with no Thunderbird running, and it keeps manual
# launches consistent. Only the autostart is per-host.
windowrule = match:class org.mozilla.Thunderbird, workspace 10 silent

##############################
### PER-HOST OVERRIDES      ###
##############################
# The ONLY templated line in this file. Everything hardware-, output- or
# role-specific lives in the host file and is sourced LAST so it can override
# the catch-all monitor line and add host-only binds, env and services.
source = ~/.config/hypr/host/{{ .chezmoi.hostname }}.conf
