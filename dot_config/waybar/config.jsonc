{
    "layer": "top",
    "position": "top",
    "height": 44,
    "spacing": 6,

    "modules-left": ["hyprland/workspaces", "custom/wstaskbar"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "network", "bluetooth", "cpu", "memory", "tray", "custom/power"],

    "custom/launcher": {
        "format": "⊞",
        "tooltip": false,
        "on-click": "wofi --show drun"
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "/home/<user>/.config/hypr/scripts/powermenu.sh"
    },

    "hyprland/workspaces": {
        "on-click": "activate",
        "format": "{id}"
    },

    "hyprland/window": {
        "max-length": 60,
        "separate-outputs": true
    },

    "custom/wstaskbar": {
        "exec": "/home/<user>/.config/hypr/scripts/ws-taskbar.py",
        "format": "{}",
        "tooltip": false,
        "escape": true
    },

    "wlr/taskbar": {
        "format": "{icon} {short_title}",
        "icon-size": 16,
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close",
        "all-outputs": true,
        "ignore-list": ["com.claude.remote"]
    },

    "clock": {
        "locale": "es_AR.UTF-8",
        "format": "<span rise='-1200' size='125%'>󰅐</span>  {:L%H:%M  ·  %a %d %b}",
        "tooltip": false,
        "on-click": "env LC_ALL=es_AR.UTF-8 gsimplecal"
    },

    "pulseaudio": {
        "format": "<span color='#bd93f9'>{icon}</span>  {volume}%",
        "format-muted": "<span color='#6272a4' rise='-1200' size='125%'>󰝟</span>  muted",
        "format-icons": { "default": ["<span rise='-1200' size='125%'>󰕿</span>", "<span rise='-1200' size='125%'>󰖀</span>", "<span rise='-1200' size='125%'>󰕾</span>"] },
        "on-click": "pavucontrol"
    },

    "network": {
        "format-wifi": "<span color='#bd93f9' rise='-1200' size='125%'>󰖩</span>  {essid}",
        "format-ethernet": "<span color='#bd93f9' rise='-1200' size='125%'>󰈀</span>  eth",
        "format-disconnected": "<span color='#6272a4' rise='-1200' size='125%'>󰖪</span>  off",
        "tooltip-format": "{ifname}: {ipaddr}",
        "on-click": "/home/<user>/.config/hypr/scripts/network-menu.sh",
        "on-click-right": "nm-connection-editor"
    },

    "bluetooth": {
        "format": "<span color='#bd93f9' rise='-1200' size='125%'>󰂯</span>",
        "format-connected": "<span color='#bd93f9' rise='-1200' size='125%'>󰂱</span>  ({num_connections})",
        "format-disabled": "<span color='#6272a4' rise='-1200' size='125%'>󰂲</span>",
        "format-off": "<span color='#6272a4' rise='-1200' size='125%'>󰂲</span>",
        "tooltip-format": "{controller_alias} · {status}",
        "tooltip-format-connected": "{controller_alias} · {status}\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias} · {device_battery_percentage}%",
        "on-click": "overskride"
    },

    "cpu": {
        "format": "<span color='#bd93f9' rise='-1200' size='125%'>󰓅</span>  {usage}%",
        "states": { "warning": 70, "critical": 90 },
        "interval": 2,
        "tooltip-format": "CPU: {usage}%"
    },

    "memory": {
        "format": "<span color='#bd93f9' rise='-1200' size='125%'>󰍛</span>  {percentage}%",
        "states": { "warning": 75, "critical": 90 },
        "interval": 5,
        "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G"
    },

    "tray": {
        "spacing": 10
    }
}
