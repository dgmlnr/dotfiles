# Repo-meta files: keep them in the repo, but chezmoi must NOT create them in $HOME.
README.md
LICENSE
packages/
docs/

# Secrets: never manage the machine-local secrets file (created by hand per machine).
.config/shell/secrets.sh

# Work identity: a per-machine git identity (name + address) that has no business
# in a public repo. `.gitconfig` includes it for repos under ~/repos/gitea/; git
# ignores a missing include, so a machine without it just uses the default
# identity. Created by hand — see the README.
.gitconfig-work

# lazysql: its config.toml embeds a DB connection string with a plaintext password,
# and private_history/ stores query history naming internal databases and tables.
# Purged from history on 2026-07-19; keep it out for good.
.config/lazysql/

# Regenerable state that must never be tracked, in case it is ever added by mistake.
.config/fish/completions/
.config/fish/generated_completions/
.config/fish/fish_variables
.config/fish/__pycache__/
.config/hypr/scripts/__pycache__/
.config/nvim/spell/
.config/zellij/plugins/
.config/mako/config.bak

# Remote-access SERVER scripts: only `hexdev` runs wayvnc + Sunshine/Moonlight.
# On every other host these are dead code that would sit in $HOME referencing
# services and outputs that do not exist there, so they are never materialised.
# NOTE: this block matches TARGET paths under .config/hypr/scripts/ only. It must
# never touch .config/hypr/host/*.conf — BOTH host files have to exist on BOTH
# machines, because hyprland.conf sources host/<hostname>.conf unconditionally.
{{ if ne .chezmoi.hostname "hexdev" -}}
.config/hypr/scripts/vnc-mode-on.sh
.config/hypr/scripts/vnc-mode-off.sh
.config/hypr/scripts/vnc-watch.sh
.config/hypr/scripts/wayvnc-keepalive.sh
.config/hypr/scripts/moonlight-display.sh
.config/hypr/scripts/moonlight-watchdog.sh
.config/hypr/scripts/panic-restore.sh
{{- end }}
