# Lock screen — https://wiki.hyprland.org/Hypr-Ecosystem/hyprlock/
background {
    monitor =
    path = {{ .chezmoi.homeDir }}/.config/hypr/wallpapers/escritorio.jpg
    blur_passes = 2
    blur_size = 6
}

input-field {
    monitor =
    size = 320, 50
    outline_thickness = 2
    dots_center = true
    rounding = 10
    # Dracula accents
    inner_color = rgb(282a36)
    outer_color = rgb(a17dd4)
    font_color = rgb(f8f8f2)
    check_color = rgb(ff79c6)
    fail_color = rgb(ff5555)
    placeholder_text = <i>Password...</i>
    position = 0, -40
    halign = center
    valign = center
}

label {
    monitor =
    text = cmd[update:1000] echo "$TIME"
    color = rgb(f8f8f2)
    font_size = 64
    position = 0, 120
    halign = center
    valign = center
}

# Fecha en español
label {
    monitor =
    text = cmd[update:60000] echo "$(LC_TIME=es_AR.UTF-8 date '+%A, %d de %B')"
    color = rgba(248, 248, 242, 0.85)
    font_size = 20
    position = 0, 55
    halign = center
    valign = center
}

# Botón apagar (rojo) — arriba a la derecha
# Nota: eje Y invertido en hyprlock (valign=top → Y negativo baja desde el borde)
label {
    monitor =
    text = 󰐥
    color = rgb(ff5555)
    font_family = IosevkaTerm Nerd Font Mono
    font_size = 26
    position = -40, -30
    halign = right
    valign = top
    onclick = systemctl poweroff
}

# Botón reiniciar (violeta) — a la izquierda del de apagar
label {
    monitor =
    text = 󰜉
    color = rgb(a17dd4)
    font_family = IosevkaTerm Nerd Font Mono
    font_size = 26
    position = -90, -30
    halign = right
    valign = top
    onclick = systemctl reboot
}
