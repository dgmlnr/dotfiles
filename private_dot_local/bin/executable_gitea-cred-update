#!/usr/bin/env bash
# Replace the Gitea credential in the keyring of BOTH machines.
#
# The token is read from a silent prompt and never appears on screen, in the
# shell history, or in a process argument list. Every store is silenced and
# verified separately by presence only.
#
# Usage: gitea-cred-update

set -uo pipefail

HOST_GITEA="gitea.example.com"
REMOTE="hexdev"
HELPER="/usr/lib/git-core/git-credential-libsecret"
USER_GITEA="<user>"

die() { printf '\033[1;31m✗\033[0m %s\n' "$*" >&2; exit 1; }
ok()  { printf '\033[1;32m✓\033[0m %s\n' "$*"; }
info(){ printf '\033[1;36m==>\033[0m %s\n' "$*"; }

[ -x "$HELPER" ] || die "no encuentro $HELPER"

info "Pegá el token NUEVO de Gitea (no se va a ver nada al escribir):"
read -rs TOKEN
echo
[ -n "$TOKEN" ] || die "token vacío, no hice nada"
printf '  token recibido (%d caracteres)\n' "${#TOKEN}"

# --- local -------------------------------------------------------------------
info "Guardando en el keyring local ($(hostname))"
printf 'protocol=https\nhost=%s\nusername=%s\npassword=%s\n\n' \
    "$HOST_GITEA" "$USER_GITEA" "$TOKEN" \
    | "$HELPER" store >/dev/null 2>&1 \
    || die "falló el store local"

printf 'protocol=https\nhost=%s\n\n' "$HOST_GITEA" \
    | "$HELPER" get 2>/dev/null | rg -q '^password=' \
    && ok "keyring local: credencial presente" \
    || die "el keyring local no la devuelve"

# --- remote ------------------------------------------------------------------
info "Guardando en el keyring de $REMOTE"
printf 'protocol=https\nhost=%s\nusername=%s\npassword=%s\n\n' \
    "$HOST_GITEA" "$USER_GITEA" "$TOKEN" \
    | ssh -o ConnectTimeout=10 "$REMOTE" \
        "bash -c 'export XDG_RUNTIME_DIR=/run/user/\$(id -u); $HELPER store' " \
        >/dev/null 2>&1 \
    || die "falló el store remoto"

unset TOKEN

ssh -o ConnectTimeout=10 "$REMOTE" \
    "bash -c 'export XDG_RUNTIME_DIR=/run/user/\$(id -u); printf \"protocol=https\nhost=$HOST_GITEA\n\n\" | $HELPER get' " \
    2>/dev/null | rg -q '^password=' \
    && ok "keyring de $REMOTE: credencial presente" \
    || die "el keyring remoto no la devuelve"

# --- real auth test on both --------------------------------------------------
info "Probando autenticación real contra Gitea"

printf '  %-14s ' "$(hostname):"
if GIT_TERMINAL_PROMPT=0 timeout 30 git ls-remote \
     "https://$HOST_GITEA/$USER_GITEA/<probe-repo>.git" HEAD >/dev/null 2>&1; then
    printf '\033[1;32mOK\033[0m\n'
else
    printf '\033[1;31mFALLA\033[0m — ¿el token nuevo tiene permisos de lectura?\n'
fi

printf '  %-14s ' "$REMOTE:"
if ssh -o ConnectTimeout=10 "$REMOTE" \
     "bash -c 'export XDG_RUNTIME_DIR=/run/user/\$(id -u); GIT_TERMINAL_PROMPT=0 timeout 30 git ls-remote https://$HOST_GITEA/$USER_GITEA/<probe-repo>.git HEAD' " \
     >/dev/null 2>&1; then
    printf '\033[1;32mOK\033[0m\n'
else
    printf '\033[1;31mFALLA\033[0m\n'
fi

echo
ok "Listo. El token viejo queda invalidado por la rotación que hiciste en Gitea."
