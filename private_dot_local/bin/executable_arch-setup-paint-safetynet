#!/usr/bin/env bash
# Replicate the hexdev setup on any Arch-based machine (e.g. hexdev-home).
#
# What it installs (all idempotent — safe to re-run):
#   1. Drawing         — MS-Paint-like image editor; shows in the app launcher.
#   2. Update safety net for pacman:
#        Level 1 — PreTransaction hook that backs up package lists + /etc
#                  into /var/backups/pacman/ BEFORE every transaction.
#        Level 2 — paccache cache pruning (keep 2 versions) + weekly timer.
#
# Needs sudo for the system-level parts (it will prompt).
# NOT replicated on purpose: system upgrades and .pacnew merges — those are
# per-machine and must be run/reviewed locally.

set -uo pipefail

info() { printf '\033[1;36m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*"; }

# --- Guard: Arch-based only -------------------------------------------------
command -v pacman >/dev/null || { warn "Requiere un sistema Arch (pacman). Abortando."; exit 1; }

# --- 1. Drawing + paccache tooling ------------------------------------------
info "Instalando Drawing + pacman-contrib (trae paccache)..."
sudo pacman -S --needed --noconfirm drawing pacman-contrib

# --- 2. Level 1: backup script ----------------------------------------------
info "Nivel 1: escribiendo /usr/local/bin/pacman-safety-backup.sh ..."
sudo tee /usr/local/bin/pacman-safety-backup.sh >/dev/null <<'SCRIPT'
#!/usr/bin/env bash
# Level 1 safety net: snapshot package lists + /etc BEFORE every pacman transaction.
# Runs as root from a PreTransaction hook. It must NEVER fail the transaction,
# so every step is guarded and the script always exits 0.
dest=/var/backups/pacman
mkdir -p "$dest" 2>/dev/null || exit 0
pacman -Qqe > "$dest/pkglist.txt"     2>/dev/null || true  # explicitly installed
pacman -Qqm > "$dest/pkglist-aur.txt" 2>/dev/null || true  # foreign / AUR
stamp="$(date +%Y%m%d-%H%M%S)"
tar czf "$dest/etc-$stamp.tar.gz" -C / etc 2>/dev/null || true
# rotation: keep only the 5 most recent /etc snapshots
ls -1t "$dest"/etc-*.tar.gz 2>/dev/null | tail -n +6 | xargs -r rm -f
exit 0
SCRIPT
sudo chmod 755 /usr/local/bin/pacman-safety-backup.sh

# --- Level 1: PreTransaction hook -------------------------------------------
info "Nivel 1: escribiendo /etc/pacman.d/hooks/00-safety-backup.hook ..."
sudo mkdir -p /etc/pacman.d/hooks
sudo tee /etc/pacman.d/hooks/00-safety-backup.hook >/dev/null <<'HOOK'
[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = *

[Action]
Description = Safety net: backing up package lists and /etc...
When = PreTransaction
Exec = /usr/local/bin/pacman-safety-backup.sh
HOOK

# --- 2. Level 2: cache pruning + timer --------------------------------------
info "Nivel 2: podando cache y activando paccache.timer ..."
sudo paccache -rk2  || true   # installed:   keep 2 versions
sudo paccache -ruk0 || true   # uninstalled: drop from cache
sudo systemctl enable --now paccache.timer

# --- Smoke test -------------------------------------------------------------
info "Probando el backup una vez..."
sudo /usr/local/bin/pacman-safety-backup.sh
info "Backup en /var/backups/pacman/:"
sudo ls -lh /var/backups/pacman/ 2>/dev/null

info "LISTO. Drawing en el launcher + red de seguridad (Nivel 1+2) activa."
info "Recorda: siempre 'sudo pacman -Syu' (nunca '-Sy' solo)."
